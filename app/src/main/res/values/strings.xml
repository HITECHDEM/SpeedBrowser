    <string name="toggle_ram_cache">96MB RAM Asset Cache (0ms I/O)</string>
    <string name="toggle_ram_cache_desc">Caches Speedometer JS/CSS/WASM/HTML in memory with immutable V8 bytecode headers to eliminate flash/network reloads.</string>
    <string name="toggle_keep_warm">Keep Warm Renderer &amp; Shader Pool</string>
    <string name="toggle_keep_warm_desc">Reuses the live WebView renderer &amp; V8 isolate across consecutive runs instead of cold-restarting.</string>
    <string name="toggle_offscreen_preraster">Offscreen Tile Pre-Raster</string>
    <string name="toggle_offscreen_preraster_desc">Pre-renders offscreen scroll tiles (off by default so GPU focuses 100% on visible benchmark frames).</string>
    <string name="toggle_compact_sheet">Compact Sheet Mode (Preview Window)</string>
    <string name="toggle_compact_sheet_desc">Opens Custom Tab as a 78%-height adjustable sheet (similar to in-app preview windows) for viewport comparison.</string>
    <string name="toggle_clean_cookies">Wipe Cookies &amp; DOM Storage on Launch</string>
    <string name="toggle_clean_cookies_desc">Clears cookies/localStorage before each run (off by default to keep IndexedDB &amp; ServiceWorker storage warm).</string>
    <string name="toggle_zero_overlay">Zero-Overlay Pure Mode</string>
    <string name="toggle_zero_overlay_desc">Runs pure Android View WebView with zero Compose tree or toolbar overhead (press Back to reveal controls).</string>
    <string name="toggle_max_refresh">Unlock Max Refresh Rate (90–144 Hz)</string>
    <string name="toggle_max_refresh_desc">Requests highest display mode so requestAnimationFrame &amp; paint subtests aren\'t capped at 60 Hz.</string>
    <string name="toggle_peak_burst">ADPF Peak Burst Clocks + Keep Screen On</string>
    <string name="toggle_peak_burst_desc">Engages PerformanceHintManager ADPF session, disables sustained throttling cap &amp; locks renderer as IMPORTANT.</string>
    <string name="status_profile_cleaned">Runtime, RAM &amp; disk caches reset cleanly</string>

